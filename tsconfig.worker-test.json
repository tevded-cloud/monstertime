{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker-test.tsbuildinfo",
    "target": "es2023",
    /* No DOM. These tests run inside workerd, where the globals are the
       Workers runtime's, and pulling DOM in makes the two collide: the browser
       declares its own Scheduler without `wait`, which then shadows the real
       one and fails on the line that uses it. */
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test/worker/**/*.ts", "test/worker/**/*.d.ts", "vitest.workers.config.ts"]
}
