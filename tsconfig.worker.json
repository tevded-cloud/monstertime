{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,

    /* Bundler mode: wrangler bundles this with esbuild, same as Vite does src. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Only the worker is a root here. The pieces it pulls in from src (the shared
     types and the genetics) are checked as part of this project too, because
     they are reached through its imports, and that is the point: it is how the
     one copy of the genetics is proven to compile without the DOM. */
  "include": ["worker"]
}
