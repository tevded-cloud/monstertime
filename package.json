{
  "name": "monstertime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev -c wrangler.dev.jsonc",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/build-sw.mjs",
    "check": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:dna": "vitest run",
    "test:worker": "vitest run -c vitest.workers.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "stage": "node scripts/deploy.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
